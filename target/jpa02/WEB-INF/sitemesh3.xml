<sitemesh>
    <!-- SiteMesh 3 tự thêm tiền tố /WEB-INF/decorators/ -> chỉ ghi tên file JSP -->

    <!-- Không trang trí cho tài nguyên trả về thô -->
    <mapping path="/image/*" exclude="true"/>
    <mapping path="/image" exclude="true"/>
    <mapping path="/api/*" exclude="true"/>

    <!-- Khu vực quản trị: layout có sidebar -->
    <mapping path="/admin/*" decorator="admin.jsp"/>

    <!-- Khu vực người dùng đã đăng nhập -->
    <mapping path="/user/*" decorator="user.jsp"/>

    <!-- Mặc định cho toàn site -->
    <mapping path="/*" decorator="web.jsp"/>
</sitemesh>
